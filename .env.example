# Copy the connection string from this machine's ForgeVPS Databases pane.
DATABASE_URL=postgresql://boomer_drop_app:change_me@127.0.0.1:5432/boomer_drop
HOST=127.0.0.1
PORT=5012
# HTTPS domain pointing to this VPS; used for QR links and WebSocket origins.
BOOMER_DROP_PUBLIC_ORIGIN=https://drop.example.com
# Optional cross-network relay (existing Cloudflare TURN integration).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Local LAN testing only:
# BOOMER_DROP_PUBLIC_HOST=192.168.1.23
